# Material Hub API - Environment template
# Copy to .env and set values. Do not commit .env.

DB_HOST=mysql
DB_PORT=3306
DB_USER=material_hub
DB_PASSWORD=your_secure_password
DB_NAME=material_hub

# Optional
PORT=3000

# SMTP for report emails to reports@italpac.co.za
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Material Hub <noreply@example.com>

# Egnyte report cloud upload (reports zipped + pushed in addition to email)
# When unset, Egnyte upload is skipped silently.
# EGNYTE_DOMAIN=italpac1a
# EGNYTE_ACCESS_TOKEN=
# EGNYTE_UPLOAD_PATH=/Shared/IP - Device Reports/API - Material Hub
