# Material Hub API - Environment template
# Copy to .env and set values. Do not commit .env.

DB_HOST=mysql
DB_PORT=3306
DB_USER=material_hub
DB_PASSWORD=your_secure_password
DB_NAME=material_hub

# Optional
PORT=3000

# Egnyte report cloud upload (reports are zipped + pushed here; no email)
# When unset, Egnyte upload is skipped silently.
# EGNYTE_DOMAIN=italpac1a
# EGNYTE_ACCESS_TOKEN=
# EGNYTE_UPLOAD_PATH=/Shared/IP - Device Reports/API - Material Hub
